[Unit]
Description=Identity Risk Analyzer (Tailscale-only backend)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=identityrisk
Group=identityrisk
WorkingDirectory=/opt/identity-risk/backend
ExecStart=/opt/identity-risk/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

RADAR_DB_PATH=./data/radar.db
RADAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LDAP_HOST=100.93.42.103
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_VALIDATE_CERT=true
LDAP_BASE_DN=DC=infraradar,DC=test
LDAP_USER_BASE_DN=OU=InfraRadarLab,DC=infraradar,DC=test
LDAP_USERNAME=ir-ldap-reader@infraradar.test
# Set LDAP_PASSWORD only in backend/.env or a secret environment variable.
INACTIVE_DAYS=90
OLD_PASSWORD_DAYS=180
INACTIVE_COMPUTER_DAYS=90
OWNER_ATTRIBUTE=managedBy
# Read-only snapshot made with scripts/Export-InteractiveRights.ps1 (max age 60 min).
# INTERACTIVE_POLICY_PATH=./data/interactive-rights.json
# Separate non-admin SSH account with Security Event Log read access, if configured.
# EVENT_SSH_ALIAS=infraradar-event-reader
# EVENT_SSH_USER=ir-event-reader
BRUTE_ATTEMPTS=5
SPRAY_UNIQUE_USERS=5
AUTH_WINDOW_MINUTES=10
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_CRITICAL_THRESHOLD=80
CRITICAL_GROUPS=Domain Admins,Enterprise Admins,Schema Admins,Administrators,Account Operators,Server Operators,Backup Operators,DNSAdmins,IR-Lab-Admins
